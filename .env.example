# Writer app mode: runtime (default) or evaluation. Evaluation mode stores
# the effective system prompt, injected text context, and tool JSON Schemas in
# the related local conversation for evaluation. These snapshots can contain
# manuscript text, so enable the mode only on an evaluation machine.
MAIN_VITE_WRITER_APP_MODE=runtime

# Writer public-data service prefix. Keep the real deployment URL in
# .env; this example is safe to commit.
MAIN_VITE_WRITER_PUBLIC_DATA_API_BASE_URL=https://api.example.test

# Optional Bearer key for a reverse proxy in front of the public-data routes.
MAIN_VITE_WRITER_PUBLIC_DATA_API_KEY=

# Official release builds restore this file from the repository Actions secret
# WRITER_RELEASE_ENV. Upload with: gh secret set WRITER_RELEASE_ENV < .env
# MAIN_VITE values are compiled into Main; installed apps do not need this file.

# 云备份复用上面的公开数据 API 地址；OSS 凭据只配置在 API 服务端。

# Release maintainers provide approved Google OAuth Desktop app clients.
# MAIN_VITE values go into the desktop Main bundle. Use public native clients
# with PKCE. Never use confidential web-server clients here.
# In GitHub Actions, use the same names without MAIN_VITE_ as secret names.
# MAIN_VITE_WRITER_GOOGLE_GEMINI_CLIENT_ID=
# MAIN_VITE_WRITER_GOOGLE_GEMINI_CLIENT_SECRET=
# MAIN_VITE_WRITER_GOOGLE_ANTIGRAVITY_CLIENT_ID=
# MAIN_VITE_WRITER_GOOGLE_ANTIGRAVITY_CLIENT_SECRET=
